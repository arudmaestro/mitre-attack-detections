// Title: Failed Logons for Many Accounts from One Source
// ATT&CK: T1110.003 | Tactic: CredentialAccess | Sigma id: bcfe7244-3339-4a31-9467-01c3db407ff2
// Data source: SecurityEvent 4625 (Windows Security Events connector)
// Severity: High
// False positives: Shared jump hosts, VDI or Citrix servers where many users mistype passwords; Vulnerability scanners with credentialed checks
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: map the group-by fields: IpAddress
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4625 and (not((IpAddress in~ ("-", "127.0.0.1", "::1"))))
| summarize value_count = dcount(TargetUserName) by bin(TimeGenerated, 1h), IpAddress
| where value_count >= 10
