// Title: Download Command Started Directly by Explorer
// ATT&CK: T1204.004 | Tactic: Execution | Sigma id: 8c28d2bd-381f-42f2-91e4-85902c0c0a99
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Administrators running install one-liners (e.g. irm ... | iex) from the Run dialog
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where ParentProcessName endswith "\\explorer.exe" and ((NewProcessName endswith "\\mshta.exe" and CommandLine contains "http") or ((NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and (CommandLine contains "iwr " or CommandLine contains "irm " or CommandLine contains "Invoke-WebRequest" or CommandLine contains "Invoke-RestMethod" or CommandLine contains "DownloadString" or CommandLine contains "Net.WebClient" or CommandLine contains "Start-BitsTransfer")))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
