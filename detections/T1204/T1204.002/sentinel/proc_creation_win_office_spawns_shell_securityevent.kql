// Title: Office Application Spawning a Shell or Script Host
// ATT&CK: T1204.002 | Tactic: Execution | Sigma id: f3fb2c62-6f7e-4dae-a3f1-5bb7681ebea9
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Business macros and add-ins that run commands by design (allowlist by command line)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (ParentProcessName endswith "\\WINWORD.EXE" or ParentProcessName endswith "\\EXCEL.EXE" or ParentProcessName endswith "\\POWERPNT.EXE" or ParentProcessName endswith "\\MSACCESS.EXE" or ParentProcessName endswith "\\MSPUB.EXE" or ParentProcessName endswith "\\ONENOTE.EXE") and (NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\regsvr32.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\bitsadmin.exe" or NewProcessName endswith "\\msbuild.exe")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
