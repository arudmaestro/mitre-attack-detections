// Title: Script File Opened from Downloads, Temp or Outlook Attachments
// ATT&CK: T1204.002 | Tactic: Execution | Sigma id: 5e7dd240-866c-4ae0-a151-a3796bc5e746
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Installers and login scripts that run VBScript from a temporary folder
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe") and (CommandLine contains "\\Downloads\\" or CommandLine contains "\\AppData\\Local\\Temp\\" or CommandLine contains "\\Content.Outlook\\" or CommandLine contains "\\INetCache\\")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
