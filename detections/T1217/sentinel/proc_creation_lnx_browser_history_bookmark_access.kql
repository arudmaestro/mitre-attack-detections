// Title: Browser Bookmarks or History Read from the Command Line on Linux
// ATT&CK: T1217 | Tactic: Discovery | Sigma id: 2d631b1c-4d9c-4c05-96ef-bd6c119ac120
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Backup and browser-migration scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where ProcessCommandLine contains "/google-chrome/Default/Bookmarks" or ProcessCommandLine contains "/google-chrome/Default/History" or ProcessCommandLine contains "/chromium/Default/Bookmarks" or ProcessCommandLine contains "/chromium/Default/History" or ProcessCommandLine contains "/places.sqlite"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
