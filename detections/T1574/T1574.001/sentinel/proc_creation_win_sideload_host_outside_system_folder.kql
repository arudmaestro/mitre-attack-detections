// Title: DLL Side-Loading Host Program Running Outside Its Normal Folder
// ATT&CK: T1574.001 | Tactic: Stealth, Execution | Sigma id: deca6001-564e-4077-b703-2301e2480c4f
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: High
// False positives: Windows servicing copies of dism.exe in temporary folders during updates; Windows installed on another drive letter
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\dism.exe" or FolderPath endswith "\\winsat.exe" or FolderPath endswith "\\wermgr.exe" or FolderPath endswith "\\MpCmdRun.exe" or FolderPath endswith "\\NisSrv.exe" or FolderPath endswith "\\msdtc.exe" or FolderPath endswith "\\consent.exe" or FolderPath endswith "\\colorcpl.exe") and (not((FolderPath startswith "C:\\Windows\\System32\\" or FolderPath startswith "C:\\Windows\\SysWOW64\\" or FolderPath startswith "C:\\Windows\\WinSxS\\" or FolderPath startswith "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\" or FolderPath startswith "C:\\Program Files\\Windows Defender\\")))
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
