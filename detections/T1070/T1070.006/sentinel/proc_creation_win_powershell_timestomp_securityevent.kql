// Title: File Timestamps Modified with PowerShell
// ATT&CK: T1070.006 | Tactic: Stealth | Sigma id: 3a09dfd0-5304-480c-b24d-93471881ca1a
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Scripts that preserve or reset timestamps (backups, build tools)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and (CommandLine contains "CreationTime" or CommandLine contains "LastWriteTime" or CommandLine contains "LastAccessTime") and CommandLine contains "="
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
