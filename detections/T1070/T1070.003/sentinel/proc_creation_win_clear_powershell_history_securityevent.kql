// Title: PowerShell History Cleared or Disabled
// ATT&CK: T1070.003 | Tactic: Stealth | Sigma id: 61139bcd-0563-4ad8-8800-4d4cb7e4f89b
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Privacy or hardening scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where CommandLine contains "Clear-History" or CommandLine contains "ConsoleHost_history.txt" or CommandLine contains "HistorySavePath" or CommandLine contains "SaveNothing"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
