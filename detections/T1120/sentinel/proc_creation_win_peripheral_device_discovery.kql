// Title: Peripheral and Drive Discovery on Windows
// ATT&CK: T1120 | Tactic: Discovery | Sigma id: fcf85c81-39e7-4124-b79f-fca20f4bc8cc
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Inventory, support and device-management tools
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\fsutil.exe" and ProcessCommandLine contains "fsinfo drives") or (FolderPath endswith "\\wmic.exe" and (ProcessCommandLine contains "logicaldisk" or ProcessCommandLine contains "diskdrive" or ProcessCommandLine contains "usbcontroller" or ProcessCommandLine contains "win32_pnpentity")) or ProcessCommandLine contains "Get-PnpDevice"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
