// Title: Peripheral and Drive Discovery on Windows
// ATT&CK: T1120 | Tactic: Discovery | Sigma id: fcf85c81-39e7-4124-b79f-fca20f4bc8cc
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Inventory, support and device-management tools
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\fsutil.exe" and CommandLine contains "fsinfo drives") or (NewProcessName endswith "\\wmic.exe" and (CommandLine contains "logicaldisk" or CommandLine contains "diskdrive" or CommandLine contains "usbcontroller" or CommandLine contains "win32_pnpentity")) or CommandLine contains "Get-PnpDevice"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
