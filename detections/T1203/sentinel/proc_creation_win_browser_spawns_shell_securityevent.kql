// Title: Web Browser Spawning a Shell or Script Host
// ATT&CK: T1203 | Tactic: Execution | Sigma id: ac422a4d-2cdf-4fe1-9257-1789f0e4c30d
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Browser extensions with native-messaging hosts that are scripts; Users opening downloaded .bat/.cmd/.hta files directly from the browser's download bar
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where ((ParentProcessName endswith "\\chrome.exe" or ParentProcessName endswith "\\msedge.exe" or ParentProcessName endswith "\\firefox.exe" or ParentProcessName endswith "\\brave.exe" or ParentProcessName endswith "\\iexplore.exe") and (NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe" or NewProcessName endswith "\\rundll32.exe" or NewProcessName endswith "\\regsvr32.exe")) and (not(CommandLine contains "chrome-extension://"))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
