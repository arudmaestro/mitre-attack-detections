// Title: Backup, Database or Security Service Stopped
// ATT&CK: T1489 | Tactic: Impact | Sigma id: 5132afa2-5987-479b-a58a-1c9d2949cd14
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Database and backup maintenance scripts that stop services for patching
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (((NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe" or NewProcessName endswith "\\sc.exe") and CommandLine contains " stop ") or NewProcessName endswith "\\taskkill.exe" or CommandLine contains "Stop-Service") and (CommandLine contains "MSSQL" or CommandLine contains "SQLWriter" or CommandLine contains "SQLAgent" or CommandLine contains "sqlservr" or CommandLine contains "MSExchange" or CommandLine contains "VSS" or CommandLine contains "wbengine" or CommandLine contains "Veeam" or CommandLine contains "BackupExec" or CommandLine contains "Acronis" or CommandLine contains "Sophos")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
