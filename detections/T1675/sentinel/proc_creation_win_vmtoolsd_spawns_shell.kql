// Title: VMware Tools Started a Shell or Script Host
// ATT&CK: T1675 | Tactic: Execution | Sigma id: 8f4ac52d-a6f3-4584-b761-2393f9e3469a
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: VMware administrators running guest scripts with PowerCLI Invoke-VMScript
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (InitiatingProcessFolderPath endswith "\\vmtoolsd.exe" and (FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\wscript.exe" or FolderPath endswith "\\cscript.exe" or FolderPath endswith "\\mshta.exe")) and (not((ProcessCommandLine contains "poweron-vm-default" or ProcessCommandLine contains "poweroff-vm-default" or ProcessCommandLine contains "resume-vm-default" or ProcessCommandLine contains "suspend-vm-default")))
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
