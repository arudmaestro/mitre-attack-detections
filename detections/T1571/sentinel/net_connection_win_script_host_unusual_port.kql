// Title: Shell or Script Host Connected to an Uncommon Port
// ATT&CK: T1571 | Tactic: CommandAndControl | Sigma id: 26deebc2-c2f4-43f6-bbe2-7baa496e905c
// Data source: DeviceNetworkEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Administration scripts that connect to databases, SSH or custom application ports
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = InitiatingProcessAccountName, IP = RemoteIP
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceNetworkEvents
| where TimeGenerated > ago(1d)
| where ActionType != "InboundConnectionAccepted"
| where (InitiatingProcessFolderPath endswith "\\powershell.exe" or InitiatingProcessFolderPath endswith "\\pwsh.exe" or InitiatingProcessFolderPath endswith "\\cmd.exe" or InitiatingProcessFolderPath endswith "\\mshta.exe" or InitiatingProcessFolderPath endswith "\\wscript.exe" or InitiatingProcessFolderPath endswith "\\cscript.exe" or InitiatingProcessFolderPath endswith "\\rundll32.exe" or InitiatingProcessFolderPath endswith "\\regsvr32.exe" or InitiatingProcessFolderPath endswith "\\MSBuild.exe") and (not((RemotePort in (53, 80, 88, 135, 389, 443, 445, 636, 3268, 5985, 5986, 8080, 8443))))
| project TimeGenerated, DeviceName, ActionType, InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, LocalIP, LocalPort, RemoteIP, RemotePort
