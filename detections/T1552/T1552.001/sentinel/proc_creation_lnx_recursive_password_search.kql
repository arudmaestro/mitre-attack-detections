// Title: Recursive Search for Passwords in Files on Linux
// ATT&CK: T1552.001 | Tactic: CredentialAccess | Sigma id: 18ac7b1d-b414-49b8-b981-17996ca55fc0
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Administrators and security teams searching for exposed passwords
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "/grep" or FolderPath endswith "/egrep") and (ProcessCommandLine contains " -r" or ProcessCommandLine contains " -ir" or ProcessCommandLine contains " -nr" or ProcessCommandLine contains " -inr" or ProcessCommandLine contains " -nir" or ProcessCommandLine contains "--recursive") and ProcessCommandLine contains "passw"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
