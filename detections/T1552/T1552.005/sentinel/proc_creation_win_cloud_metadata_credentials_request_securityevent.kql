// Title: Cloud Instance Metadata Credentials Requested from the Command Line on Windows
// ATT&CK: T1552.005 | Tactic: CredentialAccess | Sigma id: 816b8cfb-930c-4c4a-a49f-d4a2b69b388e
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Scripts on cloud instances that fetch role credentials (most SDKs do not use a command line)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where CommandLine contains "/latest/meta-data/iam/security-credentials" or CommandLine contains "/metadata/identity/oauth2/token" or CommandLine contains "/computeMetadata/v1/instance/service-accounts/"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
