// Title: Cloud Instance Metadata Credentials Requested from the Command Line on Linux
// ATT&CK: T1552.005 | Tactic: CredentialAccess | Sigma id: e07e1498-7ada-497e-afff-6a727a85af49
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Scripts on cloud instances that fetch role credentials with curl (most SDKs do not use a command line)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where ProcessCommandLine contains "/latest/meta-data/iam/security-credentials" or ProcessCommandLine contains "/metadata/identity/oauth2/token" or ProcessCommandLine contains "/computeMetadata/v1/instance/service-accounts/"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
