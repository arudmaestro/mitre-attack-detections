// Title: Domain Group Membership Discovery
// ATT&CK: T1069.002 | Tactic: Discovery | Sigma id: d85ecf95-9135-4091-b756-b9f25739e1be
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Administrators and identity management scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (((NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe") and (CommandLine contains "group" and CommandLine contains "/domain")) and (not((CommandLine contains "/add" or CommandLine contains "/delete")))) or (CommandLine contains "Get-ADGroupMember" or CommandLine contains "Get-DomainGroupMember" or CommandLine contains "Get-NetGroupMember")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
