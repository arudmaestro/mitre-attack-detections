// Title: Security-Relevant Registry Value Changed from the Command Line
// ATT&CK: T1112 | Tactic: DefenseImpairment, Persistence | Sigma id: 74d98b28-b65b-4cc4-98e9-975d3624714f
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Administrators or management tools changing these settings intentionally
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (CommandLine contains "DisableAntiSpyware" or CommandLine contains "DisableRealtimeMonitoring" or CommandLine contains "EnableLUA" or CommandLine contains "LocalAccountTokenFilterPolicy" or CommandLine contains "UseLogonCredential" or CommandLine contains "DisableRestrictedAdmin") and (CommandLine contains " add " or CommandLine contains "Set-ItemProperty" or CommandLine contains "New-ItemProperty" or CommandLine contains "Set-MpPreference")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
