// Title: Suspicious Scheduled Task Creation via schtasks
// ATT&CK: T1053.005 | Tactic: Execution, Persistence, PrivilegeEscalation | Sigma id: e0ef03a7-1b14-406e-8caa-7064d070cac1
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Software installers and updaters creating scheduled tasks; Admin automation
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where FolderPath endswith "\\schtasks.exe" and ProcessCommandLine contains " /create " and (ProcessCommandLine contains "/ru system" or ProcessCommandLine contains "/sc onlogon" or ProcessCommandLine contains "/sc onstart" or ProcessCommandLine contains "\\Users\\Public\\" or ProcessCommandLine contains "\\AppData\\" or ProcessCommandLine contains "\\Temp\\" or ProcessCommandLine contains "powershell" or ProcessCommandLine contains "wscript" or ProcessCommandLine contains "mshta")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
