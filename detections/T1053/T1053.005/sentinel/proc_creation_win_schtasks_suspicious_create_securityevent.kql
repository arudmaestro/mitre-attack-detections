// Title: Suspicious Scheduled Task Creation via schtasks
// ATT&CK: T1053.005 | Tactic: Execution, Persistence, PrivilegeEscalation | Sigma id: e0ef03a7-1b14-406e-8caa-7064d070cac1
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Software installers and updaters creating scheduled tasks; Admin automation
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where NewProcessName endswith "\\schtasks.exe" and CommandLine contains " /create " and (CommandLine contains "/ru system" or CommandLine contains "/sc onlogon" or CommandLine contains "/sc onstart" or CommandLine contains "\\Users\\Public\\" or CommandLine contains "\\AppData\\" or CommandLine contains "\\Temp\\" or CommandLine contains "powershell" or CommandLine contains "wscript" or CommandLine contains "mshta")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
