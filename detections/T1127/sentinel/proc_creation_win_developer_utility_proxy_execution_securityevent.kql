// Title: Developer Utility Used to Run Code (csi, rcsi, dnx, cdb, Tracker)
// ATT&CK: T1127 | Tactic: Stealth, Execution | Sigma id: bf8569be-6ad3-45cf-a4df-cfbd07755a1c
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Developers using these tools on build or development machines
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\csi.exe" or NewProcessName endswith "\\rcsi.exe" or NewProcessName endswith "\\dnx.exe") or (NewProcessName endswith "\\cdb.exe" and CommandLine contains "-cf") or (NewProcessName endswith "\\tracker.exe" and CommandLine contains " /d ")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
