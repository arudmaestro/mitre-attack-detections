// Title: NTDS.dit Access via ntdsutil or Command Line
// ATT&CK: T1003.003 | Tactic: CredentialAccess | Sigma id: 377519b9-a636-4ae1-b19d-39b7392e7e26
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: AD backup or disaster recovery procedures (IFM media creation); Backup software referencing ntds.dit
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\ntdsutil.exe" and (CommandLine contains "ifm" or CommandLine contains "ac i ntds" or CommandLine contains "activate instance ntds")) or CommandLine contains "ntds.dit"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
