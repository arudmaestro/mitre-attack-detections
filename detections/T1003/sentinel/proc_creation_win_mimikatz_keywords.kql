// Title: Mimikatz Module Keywords in Command Line
// ATT&CK: T1003 | Tactic: CredentialAccess | Sigma id: 34c4da1b-540f-4f9e-956c-9cc1a65d66ba
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: High
// False positives: Authorised red team or penetration testing
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where ProcessCommandLine contains "sekurlsa::" or ProcessCommandLine contains "lsadump::" or ProcessCommandLine contains "kerberos::" or ProcessCommandLine contains "crypto::" or ProcessCommandLine contains "dpapi::" or ProcessCommandLine contains "vault::" or ProcessCommandLine contains "token::elevate" or ProcessCommandLine contains "privilege::debug"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
