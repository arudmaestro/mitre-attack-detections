// Title: File Download with certutil, bitsadmin or PowerShell WebClient
// ATT&CK: T1105 | Tactic: CommandAndControl | Sigma id: b993c0e2-06b2-4b73-a15d-9db3f686eb9a
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Software updaters and admin scripts that download files
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\certutil.exe" and (ProcessCommandLine contains "urlcache" or ProcessCommandLine contains "verifyctl")) or (FolderPath endswith "\\bitsadmin.exe" and ProcessCommandLine contains "/transfer") or (ProcessCommandLine contains ".DownloadFile(" or ProcessCommandLine contains ".DownloadString(" or ProcessCommandLine contains "Start-BitsTransfer")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
