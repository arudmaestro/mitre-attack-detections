// Title: File Download with certutil, bitsadmin or PowerShell WebClient
// ATT&CK: T1105 | Tactic: CommandAndControl | Sigma id: b993c0e2-06b2-4b73-a15d-9db3f686eb9a
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Software updaters and admin scripts that download files
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\certutil.exe" and (CommandLine contains "urlcache" or CommandLine contains "verifyctl")) or (NewProcessName endswith "\\bitsadmin.exe" and CommandLine contains "/transfer") or (CommandLine contains ".DownloadFile(" or CommandLine contains ".DownloadString(" or CommandLine contains "Start-BitsTransfer")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
