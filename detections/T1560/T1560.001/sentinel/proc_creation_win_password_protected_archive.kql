// Title: Password-Protected Archive Created with 7-Zip or WinRAR
// ATT&CK: T1560.001 | Tactic: Collection | Sigma id: 00d8d085-d9a0-472d-ae0d-4d42eee624a9
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Users and backup jobs creating encrypted archives
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\7z.exe" or FolderPath endswith "\\7za.exe" or FolderPath endswith "\\7zr.exe" or FolderPath endswith "\\rar.exe" or FolderPath endswith "\\WinRAR.exe") and ProcessCommandLine contains " a " and (ProcessCommandLine contains " -p" or ProcessCommandLine contains " -hp")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
