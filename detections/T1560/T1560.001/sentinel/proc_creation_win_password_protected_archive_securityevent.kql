// Title: Password-Protected Archive Created with 7-Zip or WinRAR
// ATT&CK: T1560.001 | Tactic: Collection | Sigma id: 00d8d085-d9a0-472d-ae0d-4d42eee624a9
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Users and backup jobs creating encrypted archives
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\7z.exe" or NewProcessName endswith "\\7za.exe" or NewProcessName endswith "\\7zr.exe" or NewProcessName endswith "\\rar.exe" or NewProcessName endswith "\\WinRAR.exe") and CommandLine contains " a " and (CommandLine contains " -p" or CommandLine contains " -hp")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
