// Title: Password-Protected Archive Created on macOS
// ATT&CK: T1560.001 | Tactic: Collection | Sigma id: 04bec735-0243-4341-bf80-044f86806f44
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Users creating encrypted archives
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "/zip" and (ProcessCommandLine contains " -e " or ProcessCommandLine contains " -P " or ProcessCommandLine contains " --encrypt" or ProcessCommandLine contains " --password")) or ((FolderPath endswith "/7z" or FolderPath endswith "/7za" or FolderPath endswith "/7zz") and ProcessCommandLine contains " a " and ProcessCommandLine contains " -p")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
