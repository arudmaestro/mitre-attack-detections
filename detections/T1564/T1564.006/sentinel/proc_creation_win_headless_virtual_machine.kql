// Title: Virtual Machine Started Headless on a Windows Host
// ATT&CK: T1564.006 | Tactic: Stealth | Sigma id: a7d2e0e4-97b3-4731-9e0e-56c405fd48c5
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Developers and testers who run virtual machines
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where FolderPath endswith "\\VBoxHeadless.exe" or (FolderPath endswith "\\VBoxManage.exe" and ProcessCommandLine contains "startvm" and ProcessCommandLine contains "headless") or (FolderPath endswith "\\qemu-system-x86_64.exe" or FolderPath endswith "\\qemu-system-x86_64w.exe" or FolderPath endswith "\\qemu-system-i386.exe")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
