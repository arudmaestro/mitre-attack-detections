// Title: Password Policy Discovery on Linux
// ATT&CK: T1201 | Tactic: Discovery | Sigma id: 3de271e2-ccd2-4e35-bda6-c8e6f551ef58
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Administrators and compliance scanners checking password settings
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "/chage" and ProcessCommandLine contains "-l") or (ProcessCommandLine contains "/etc/login.defs" or ProcessCommandLine contains "/etc/security/pwquality.conf" or ProcessCommandLine contains "/etc/pam.d/common-password" or ProcessCommandLine contains "/etc/pam.d/system-auth")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
