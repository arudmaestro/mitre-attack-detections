// Title: Webhook or Bot API URL on the Command Line on Windows
// ATT&CK: T1567.004 | Tactic: Exfiltration | Sigma id: e1d881bc-7908-41ae-a62a-087ff085d3ce
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Monitoring and build scripts that post notifications to chat webhooks (allowlist them)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where ProcessCommandLine contains "discord.com/api/webhooks" or ProcessCommandLine contains "discordapp.com/api/webhooks" or ProcessCommandLine contains "hooks.slack.com/services" or ProcessCommandLine contains ".webhook.office.com" or ProcessCommandLine contains "webhook.site" or ProcessCommandLine contains "api.telegram.org/bot"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
