// Title: Text Storage Site Referenced on the Command Line on Windows
// ATT&CK: T1567.003 | Tactic: Exfiltration | Sigma id: 76193ea9-9d58-4fbb-bc92-997dec025dba
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Developers and users opening paste links from the command line or scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where ProcessCommandLine contains "pastebin.com" or ProcessCommandLine contains "paste.ee" or ProcessCommandLine contains "hastebin.com" or ProcessCommandLine contains "rentry.co" or ProcessCommandLine contains "dpaste.com" or ProcessCommandLine contains "paste.rs" or ProcessCommandLine contains "ghostbin."
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
