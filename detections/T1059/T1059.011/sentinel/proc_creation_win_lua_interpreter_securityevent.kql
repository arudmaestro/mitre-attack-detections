// Title: Lua Interpreter Executed on Windows
// ATT&CK: T1059.011 | Tactic: Execution | Sigma id: 36808368-08aa-4941-bf7e-24461b373a6e
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Developers and applications that bundle a Lua interpreter
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where NewProcessName endswith "\\lua.exe" or NewProcessName endswith "\\luajit.exe" or NewProcessName endswith "\\lua51.exe" or NewProcessName endswith "\\lua52.exe" or NewProcessName endswith "\\lua53.exe" or NewProcessName endswith "\\lua54.exe" or NewProcessName endswith "\\wlua.exe"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
