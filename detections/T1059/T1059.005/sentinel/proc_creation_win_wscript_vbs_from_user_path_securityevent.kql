// Title: VBScript Executed from User-Writable Path
// ATT&CK: T1059.005 | Tactic: Execution | Sigma id: 4769e2d6-4785-4615-9831-70ddcef3ebde
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Login scripts or admin scripts staged in Temp or Downloads
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe") and (CommandLine contains ".vbs" or CommandLine contains ".vbe") and (CommandLine contains "\\AppData\\" or CommandLine contains "\\Temp\\" or CommandLine contains "\\Users\\Public\\" or CommandLine contains "\\Downloads\\")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
