// Title: AutoHotkey or AutoIt Script Execution
// ATT&CK: T1059.010 | Tactic: Execution | Sigma id: 8d807637-9353-45c1-a691-8eaa67619e86
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Users and IT staff using AutoHotkey or AutoIt for automation
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\AutoHotkey.exe" or NewProcessName endswith "\\AutoHotkey64.exe" or NewProcessName endswith "\\AutoHotkeyU64.exe" or NewProcessName endswith "\\AutoHotkeyU32.exe" or NewProcessName endswith "\\AutoHotkeyA32.exe" or NewProcessName endswith "\\AutoIt3.exe" or NewProcessName endswith "\\AutoIt3_x64.exe") or (CommandLine contains ".ahk" or CommandLine contains ".au3")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
