// Title: JScript Executed from User-Writable Path
// ATT&CK: T1059.007 | Tactic: Execution | Sigma id: 9539797b-f314-4735-88be-258ea47c2bc3
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Legitimate scripts in Temp or Downloads; Command lines containing .json paths
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe") and CommandLine contains ".js" and (CommandLine contains "\\AppData\\" or CommandLine contains "\\Temp\\" or CommandLine contains "\\Users\\Public\\" or CommandLine contains "\\Downloads\\")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
