// Title: Windows System Process Name Running Outside System Folders
// ATT&CK: T1036.005 | Tactic: Stealth | Sigma id: 0e1dc5e6-a2c9-4c3c-aa35-1fb99ec2f566
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Windows installed on a drive other than C:; Security tools that copy system binaries for analysis
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\svchost.exe" or NewProcessName endswith "\\lsass.exe" or NewProcessName endswith "\\services.exe" or NewProcessName endswith "\\csrss.exe" or NewProcessName endswith "\\smss.exe" or NewProcessName endswith "\\wininit.exe" or NewProcessName endswith "\\winlogon.exe" or NewProcessName endswith "\\spoolsv.exe" or NewProcessName endswith "\\taskhostw.exe") and (not((NewProcessName startswith "C:\\Windows\\System32\\" or NewProcessName startswith "C:\\Windows\\SysWOW64\\" or NewProcessName startswith "C:\\Windows\\WinSxS\\")))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
