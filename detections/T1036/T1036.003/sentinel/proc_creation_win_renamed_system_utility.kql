// Title: Renamed Windows Utility (OriginalFileName Mismatch)
// ATT&CK: T1036.003 | Tactic: Stealth | Sigma id: 088f58e3-432d-4b45-a4dd-1ea178e58172
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: High
// False positives: Software that ships a renamed copy of a Windows utility
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (ProcessVersionInfoOriginalFileName =~ "Cmd.Exe" and (not(FolderPath endswith "\\cmd.exe"))) or (ProcessVersionInfoOriginalFileName =~ "PowerShell.EXE" and (not(FolderPath endswith "\\powershell.exe"))) or (ProcessVersionInfoOriginalFileName =~ "CertUtil.exe" and (not(FolderPath endswith "\\certutil.exe"))) or (ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE" and (not(FolderPath endswith "\\rundll32.exe"))) or (ProcessVersionInfoOriginalFileName =~ "MSHTA.EXE" and (not(FolderPath endswith "\\mshta.exe"))) or (ProcessVersionInfoOriginalFileName =~ "REGSVR32.EXE" and (not(FolderPath endswith "\\regsvr32.exe")))
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
