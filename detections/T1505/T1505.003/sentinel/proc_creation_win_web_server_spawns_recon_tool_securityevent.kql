// Title: Web Server Process Running Discovery or Download Tools on Windows
// ATT&CK: T1505.003 | Tactic: Persistence | Sigma id: 6a1bebc4-1f25-4a85-8307-2149fc13bd6c
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Web applications that query system information through command-line tools by design
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (ParentProcessName endswith "\\w3wp.exe" or ParentProcessName endswith "\\httpd.exe" or ParentProcessName endswith "\\nginx.exe" or ParentProcessName endswith "\\php-cgi.exe" or ParentProcessName endswith "\\tomcat.exe" or ParentProcessName endswith "\\tomcat8.exe" or ParentProcessName endswith "\\tomcat9.exe") and (NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe" or NewProcessName endswith "\\ipconfig.exe" or NewProcessName endswith "\\systeminfo.exe" or NewProcessName endswith "\\nltest.exe" or NewProcessName endswith "\\quser.exe" or NewProcessName endswith "\\query.exe" or NewProcessName endswith "\\tasklist.exe" or NewProcessName endswith "\\hostname.exe" or NewProcessName endswith "\\certutil.exe" or NewProcessName endswith "\\curl.exe" or NewProcessName endswith "\\bitsadmin.exe" or NewProcessName endswith "\\reg.exe")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
