// Title: IIS Native or Managed Module Installed
// ATT&CK: T1505.004 | Tactic: Persistence | Sigma id: 8f346254-6b2d-41ed-9416-c8a0af5f3a0f
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: IIS administrators and application installers adding modules
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\appcmd.exe" and (CommandLine contains "install module" or CommandLine contains "add module" or CommandLine contains "globalModules")) or (CommandLine contains "New-WebGlobalModule" or CommandLine contains "Enable-WebGlobalModule")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
