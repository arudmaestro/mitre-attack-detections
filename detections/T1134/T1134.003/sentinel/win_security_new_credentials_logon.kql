// Title: Logon with New Credentials (LogonType 9, seclogo)
// ATT&CK: T1134.003 | Tactic: Stealth, PrivilegeEscalation | Sigma id: 1f00f1b5-1070-45d2-ad88-e92eadf697ab
// Data source: SecurityEvent 4624 (Windows Security Events connector)
// Severity: Medium
// False positives: Administrators using runas /netonly
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4624 and LogonType == 9 and LogonProcessName contains "seclogo"
| project TimeGenerated, Computer, TargetUserName, TargetDomainName, LogonType, IpAddress, WorkstationName
