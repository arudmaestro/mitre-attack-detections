// Title: Packet Capture Started on Windows
// ATT&CK: T1040 | Tactic: CredentialAccess, Discovery | Sigma id: cd086ad6-5338-4551-955a-2c4160a07195
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Network and support engineers troubleshooting
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\netsh.exe" and (ProcessCommandLine contains "trace" and ProcessCommandLine contains "start" and ProcessCommandLine contains "capture=yes")) or (FolderPath endswith "\\pktmon.exe" and ProcessCommandLine contains "start") or (FolderPath endswith "\\tshark.exe" or FolderPath endswith "\\dumpcap.exe" or FolderPath endswith "\\windump.exe" or FolderPath endswith "\\tcpdump.exe")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
