// Title: Packet Capture Started on Windows
// ATT&CK: T1040 | Tactic: CredentialAccess, Discovery | Sigma id: cd086ad6-5338-4551-955a-2c4160a07195
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Network and support engineers troubleshooting
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\netsh.exe" and (CommandLine contains "trace" and CommandLine contains "start" and CommandLine contains "capture=yes")) or (NewProcessName endswith "\\pktmon.exe" and CommandLine contains "start") or (NewProcessName endswith "\\tshark.exe" or NewProcessName endswith "\\dumpcap.exe" or NewProcessName endswith "\\windump.exe" or NewProcessName endswith "\\tcpdump.exe")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
