// Title: Application Info.plist or Launch Environment Changed from the Command Line
// ATT&CK: T1647 | Tactic: DefenseImpairment | Sigma id: f5c91c72-a9ec-408f-a397-11c09f22f285
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Developers and build scripts editing their own app bundles
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "/defaults" or FolderPath endswith "/plutil" or FolderPath endswith "/PlistBuddy") and (ProcessCommandLine contains "Info.plist" or ProcessCommandLine contains "LSUIElement" or ProcessCommandLine contains "LSEnvironment")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
