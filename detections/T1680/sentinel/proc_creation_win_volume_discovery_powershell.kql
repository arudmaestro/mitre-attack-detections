// Title: Volumes or Disks Enumerated with PowerShell or mountvol
// ATT&CK: T1680 | Tactic: Discovery | Sigma id: 626e085d-0ba2-4f98-a42f-629663fed557
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Inventory, backup and disk management scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (ProcessCommandLine contains "Get-Volume" or ProcessCommandLine contains "Get-Disk" or ProcessCommandLine contains "Get-Partition" or ProcessCommandLine contains "Get-PSDrive" or ProcessCommandLine contains "Win32_Volume" or ProcessCommandLine contains "Win32_LogicalDisk") or FolderPath endswith "\\mountvol.exe"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
