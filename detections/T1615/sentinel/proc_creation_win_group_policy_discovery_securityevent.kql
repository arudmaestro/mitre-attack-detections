// Title: Group Policy Settings Enumerated
// ATT&CK: T1615 | Tactic: Discovery | Sigma id: 7330caa3-092c-4a5c-aa94-b8d4b8ed1a79
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Helpdesk and administrators troubleshooting Group Policy
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\gpresult.exe" and (CommandLine contains "/r" or CommandLine contains "/z" or CommandLine contains "/v" or CommandLine contains "/h" or CommandLine contains "/x")) or (CommandLine contains "Get-GPOReport" or CommandLine contains "Get-GPResultantSetOfPolicy" or CommandLine contains "Get-DomainGPO" or CommandLine contains "Get-NetGPO")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
