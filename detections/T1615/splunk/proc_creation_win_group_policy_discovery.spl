((Image="*\\gpresult.exe" CommandLine IN ("*/r*", "*/z*", "*/v*", "*/h*", "*/x*")) OR CommandLine IN ("*Get-GPOReport*", "*Get-GPResultantSetOfPolicy*", "*Get-DomainGPO*", "*Get-NetGPO*"))
