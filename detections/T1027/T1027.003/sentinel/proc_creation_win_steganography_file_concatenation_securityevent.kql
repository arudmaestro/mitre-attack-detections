// Title: Payload Hidden in Image via copy /b or Steganography Tool
// ATT&CK: T1027.003 | Tactic: Stealth | Sigma id: 9209a3bc-a2cd-401a-afeb-dedd303fd229
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Rare legitimate use of copy /b to join files
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (CommandLine contains "copy /b" and (CommandLine contains ".jpg" or CommandLine contains ".jpeg" or CommandLine contains ".png" or CommandLine contains ".gif" or CommandLine contains ".bmp") and (CommandLine contains ".zip" or CommandLine contains ".rar" or CommandLine contains ".7z" or CommandLine contains ".exe" or CommandLine contains ".ps1")) or (CommandLine contains "Invoke-PSImage" or CommandLine contains "steghide")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
