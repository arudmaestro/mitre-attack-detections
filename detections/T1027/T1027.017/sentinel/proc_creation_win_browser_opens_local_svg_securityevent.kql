// Title: Browser Opening a Local SVG File from Mail or Download Folders
// ATT&CK: T1027.017 | Tactic: Stealth | Sigma id: 8233c4e4-b3c2-4e40-b0df-db5310f16012
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Users opening legitimate SVG images received by email
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\msedge.exe" or NewProcessName endswith "\\chrome.exe" or NewProcessName endswith "\\firefox.exe" or NewProcessName endswith "\\brave.exe" or NewProcessName endswith "\\opera.exe") and CommandLine contains ".svg" and (CommandLine contains "\\Content.Outlook\\" or CommandLine contains "\\Olk\\" or CommandLine contains "\\INetCache\\" or CommandLine contains "\\Downloads\\" or CommandLine contains "\\Temp\\")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
