// Title: Obfuscated PowerShell Execution (Base64 + IEX or Char Join)
// ATT&CK: T1027.010 | Tactic: Stealth | Sigma id: 6e81c18d-629d-487d-9023-82af41a1cfea
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Some legitimate deployment or management scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe") and ((CommandLine contains "FromBase64String" and (CommandLine contains "IEX" or CommandLine contains "Invoke-Expression")) or (CommandLine contains "[char]" and CommandLine contains "-join"))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
