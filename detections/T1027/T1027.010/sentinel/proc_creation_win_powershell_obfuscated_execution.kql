// Title: Obfuscated PowerShell Execution (Base64 + IEX or Char Join)
// ATT&CK: T1027.010 | Tactic: Stealth | Sigma id: 6e81c18d-629d-487d-9023-82af41a1cfea
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Some legitimate deployment or management scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") and ((ProcessCommandLine contains "FromBase64String" and (ProcessCommandLine contains "IEX" or ProcessCommandLine contains "Invoke-Expression")) or (ProcessCommandLine contains "[char]" and ProcessCommandLine contains "-join"))
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
