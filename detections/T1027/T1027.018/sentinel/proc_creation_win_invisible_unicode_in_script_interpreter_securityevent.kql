// Title: Invisible Unicode Characters in Script Interpreter Command Line
// ATT&CK: T1027.018 | Tactic: Stealth | Sigma id: 7879736f-4774-4c34-abf7-76bb4c9097ba
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Scripts handling text in languages that use zero-width joiners (e.g. Persian, Indic scripts) or emoji
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\wscript.exe" or NewProcessName endswith "\\cscript.exe" or NewProcessName endswith "\\mshta.exe") and (CommandLine contains "​" or CommandLine contains "‌" or CommandLine contains "‍" or CommandLine contains "⁠")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
