// Title: IP Geolocation Service Queried from the Command Line on Linux
// ATT&CK: T1614 | Tactic: Discovery | Sigma id: 28bcf9b5-e43e-4c8a-b1aa-8e97beffd5ec
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Scripts and tools that look up their own location
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where ProcessCommandLine contains "ipapi.co" or ProcessCommandLine contains "ipwho.is" or ProcessCommandLine contains "geoplugin.net" or ProcessCommandLine contains "freegeoip.app" or ProcessCommandLine contains "ipgeolocation.io" or ProcessCommandLine contains "extreme-ip-lookup.com" or ProcessCommandLine contains "ip-api.io"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
