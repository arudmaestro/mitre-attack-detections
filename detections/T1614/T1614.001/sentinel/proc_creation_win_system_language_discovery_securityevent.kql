// Title: System Language or Keyboard Layout Queried from the Command Line
// ATT&CK: T1614.001 | Tactic: Discovery | Sigma id: c3901b00-bb7c-4aa2-b433-1c5adcc4a52f
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Inventory and localisation scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where CommandLine contains "Get-WinSystemLocale" or CommandLine contains "Get-WinUserLanguageList" or CommandLine contains "Get-UICulture" or CommandLine contains "\\Control\\Nls\\Language" or CommandLine contains "\\Keyboard Layout\\Preload"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
