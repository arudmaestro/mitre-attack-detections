// Title: Raw Disk Device Overwritten with dd or shred
// ATT&CK: T1561.001 | Tactic: Impact | Sigma id: cbb500d4-d0b6-4e39-b0f2-099e4f861048
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: High
// False positives: Disk imaging, secure decommissioning and OS installers
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "/dd" and (ProcessCommandLine contains "of=/dev/sd" or ProcessCommandLine contains "of=/dev/nvme" or ProcessCommandLine contains "of=/dev/vd" or ProcessCommandLine contains "of=/dev/xvd" or ProcessCommandLine contains "of=/dev/hd" or ProcessCommandLine contains "of=/dev/mmcblk")) or (FolderPath endswith "/shred" and ProcessCommandLine contains "/dev/")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
