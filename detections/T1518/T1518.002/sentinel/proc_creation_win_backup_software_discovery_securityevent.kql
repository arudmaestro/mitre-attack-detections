// Title: Backup Software Discovery on Windows
// ATT&CK: T1518.002 | Tactic: Discovery | Sigma id: 51f34752-ecb7-4808-a74d-8877e907fda5
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Backup product installers and health checks; Administrators troubleshooting backup services
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\findstr.exe" or NewProcessName endswith "\\sc.exe" or NewProcessName endswith "\\tasklist.exe" or NewProcessName endswith "\\wmic.exe" or NewProcessName endswith "\\reg.exe") and (CommandLine contains "veeam" or CommandLine contains "backupexec" or CommandLine contains "acronis" or CommandLine contains "commvault" or CommandLine contains "veritas" or CommandLine contains "arcserve" or CommandLine contains "cohesity" or CommandLine contains "rubrik")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
