// Title: Security Software Discovery on Windows
// ATT&CK: T1518.001 | Tactic: Discovery | Sigma id: a1109a39-c8b5-4397-a9c3-4f4fbaeb60bc
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Inventory, compliance and support tools checking antivirus status
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (CommandLine contains "SecurityCenter2" or CommandLine contains "AntiVirusProduct" or CommandLine contains "FirewallProduct" or CommandLine contains "Get-MpComputerStatus" or CommandLine contains "Get-MpPreference") or NewProcessName endswith "\\fltMC.exe"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
