// Title: Database Export Tool Executed on Windows
// ATT&CK: T1213.006 | Tactic: Collection | Sigma id: 22df311c-28ef-470f-b94a-404d7ca9b441
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Scheduled database backups and ETL jobs (allowlist by host and account)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\bcp.exe" and (ProcessCommandLine contains " out " or ProcessCommandLine contains " queryout ")) or (FolderPath endswith "\\mysqldump.exe" or FolderPath endswith "\\pg_dump.exe" or FolderPath endswith "\\pg_dumpall.exe" or FolderPath endswith "\\mongodump.exe" or FolderPath endswith "\\mongoexport.exe")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
