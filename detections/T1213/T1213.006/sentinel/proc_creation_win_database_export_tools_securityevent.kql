// Title: Database Export Tool Executed on Windows
// ATT&CK: T1213.006 | Tactic: Collection | Sigma id: 22df311c-28ef-470f-b94a-404d7ca9b441
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Scheduled database backups and ETL jobs (allowlist by host and account)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\bcp.exe" and (CommandLine contains " out " or CommandLine contains " queryout ")) or (NewProcessName endswith "\\mysqldump.exe" or NewProcessName endswith "\\pg_dump.exe" or NewProcessName endswith "\\pg_dumpall.exe" or NewProcessName endswith "\\mongodump.exe" or NewProcessName endswith "\\mongoexport.exe")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
