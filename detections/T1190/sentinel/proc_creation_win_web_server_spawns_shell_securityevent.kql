// Title: Web Server Process Spawning a Shell on Windows
// ATT&CK: T1190 | Tactic: InitialAccess | Sigma id: 7e69f172-7228-438e-84c0-0c2b8b89f96b
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Web applications that legitimately call command-line tools
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (ParentProcessName endswith "\\w3wp.exe" or ParentProcessName endswith "\\httpd.exe" or ParentProcessName endswith "\\nginx.exe" or ParentProcessName endswith "\\php-cgi.exe" or ParentProcessName endswith "\\tomcat.exe" or ParentProcessName endswith "\\tomcat8.exe" or ParentProcessName endswith "\\tomcat9.exe") and (NewProcessName endswith "\\cmd.exe" or NewProcessName endswith "\\powershell.exe" or NewProcessName endswith "\\pwsh.exe" or NewProcessName endswith "\\whoami.exe")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
