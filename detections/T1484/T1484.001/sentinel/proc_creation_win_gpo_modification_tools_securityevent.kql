// Title: Group Policy Changed with PowerShell or GPO Abuse Tools
// ATT&CK: T1484.001 | Tactic: DefenseImpairment, PrivilegeEscalation | Sigma id: 9ac13a67-786a-4890-a83e-f972c4b95fe1
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Administrators managing Group Policy with PowerShell
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where CommandLine contains "Set-GPRegistryValue" or CommandLine contains "Set-GPPrefRegistryValue" or CommandLine contains "New-GPLink" or CommandLine contains "SharpGPOAbuse" or CommandLine contains "--AddComputerTask" or CommandLine contains "--AddUserTask" or CommandLine contains "--AddLocalAdmin" or CommandLine contains "--AddUserRights" or CommandLine contains "--AddComputerScript" or CommandLine contains "--AddUserScript"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
