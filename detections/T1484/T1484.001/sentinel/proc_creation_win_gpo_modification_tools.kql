// Title: Group Policy Changed with PowerShell or GPO Abuse Tools
// ATT&CK: T1484.001 | Tactic: DefenseImpairment, PrivilegeEscalation | Sigma id: 9ac13a67-786a-4890-a83e-f972c4b95fe1
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Administrators managing Group Policy with PowerShell
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where ProcessCommandLine contains "Set-GPRegistryValue" or ProcessCommandLine contains "Set-GPPrefRegistryValue" or ProcessCommandLine contains "New-GPLink" or ProcessCommandLine contains "SharpGPOAbuse" or ProcessCommandLine contains "--AddComputerTask" or ProcessCommandLine contains "--AddUserTask" or ProcessCommandLine contains "--AddLocalAdmin" or ProcessCommandLine contains "--AddUserRights" or ProcessCommandLine contains "--AddComputerScript" or ProcessCommandLine contains "--AddUserScript"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
