// Title: Security Event Log Queried from the Command Line
// ATT&CK: T1654 | Tactic: Discovery | Sigma id: 8fdbc9bf-1ecc-4ab6-81f7-4e41e724eb36
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Administrators and monitoring scripts reading the Security log
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where ((NewProcessName endswith "\\wevtutil.exe" and (CommandLine contains " qe " or CommandLine contains " query-events ")) or (CommandLine contains "Get-WinEvent" or CommandLine contains "Get-EventLog")) and CommandLine contains "Security"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
