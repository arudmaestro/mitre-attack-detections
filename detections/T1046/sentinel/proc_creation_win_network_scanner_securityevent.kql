// Title: Network Scanner Executed on Windows
// ATT&CK: T1046 | Tactic: Discovery | Sigma id: 9d6fa05c-c416-4aa4-a6e2-a69b32dfcaa7
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Authorised network administrators and vulnerability scanning
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where NewProcessName endswith "\\nmap.exe" or NewProcessName endswith "\\masscan.exe" or NewProcessName endswith "\\advanced_ip_scanner.exe" or NewProcessName endswith "\\advanced_ip_scanner_console.exe" or NewProcessName endswith "\\netscan.exe" or NewProcessName endswith "\\ipscan.exe"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
