// Title: Local Account Discovery on Windows
// ATT&CK: T1087.001 | Tactic: Discovery | Sigma id: 037bc6e7-bf31-4a25-bd62-c27503d69bf3
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Administrators and inventory scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (((NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe") and CommandLine contains "user") and (not((CommandLine contains "/add" or CommandLine contains "/delete" or CommandLine contains "/domain" or CommandLine contains "/active")))) or CommandLine contains "Get-LocalUser" or (NewProcessName endswith "\\wmic.exe" and CommandLine contains "useraccount")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
