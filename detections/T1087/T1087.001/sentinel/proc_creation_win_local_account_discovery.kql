// Title: Local Account Discovery on Windows
// ATT&CK: T1087.001 | Tactic: Discovery | Sigma id: 037bc6e7-bf31-4a25-bd62-c27503d69bf3
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Administrators and inventory scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") and ProcessCommandLine contains "user") and (not((ProcessCommandLine contains "/add" or ProcessCommandLine contains "/delete" or ProcessCommandLine contains "/domain" or ProcessCommandLine contains "/active")))) or ProcessCommandLine contains "Get-LocalUser" or (FolderPath endswith "\\wmic.exe" and ProcessCommandLine contains "useraccount")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
