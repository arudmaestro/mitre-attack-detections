// Title: Domain Account Discovery
// ATT&CK: T1087.002 | Tactic: Discovery | Sigma id: bc88891d-2a87-4052-a1c0-e679fab2b6df
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Administrators and identity management scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") and (ProcessCommandLine contains "user" and ProcessCommandLine contains "/domain")) and (not((ProcessCommandLine contains "/add" or ProcessCommandLine contains "/delete")))) or (ProcessCommandLine contains "Get-ADUser" or ProcessCommandLine contains "Get-DomainUser" or ProcessCommandLine contains "Get-NetUser" or ProcessCommandLine contains "dsquery user" or ProcessCommandLine contains "objectcategory=person")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
