// Title: Domain Account Discovery
// ATT&CK: T1087.002 | Tactic: Discovery | Sigma id: bc88891d-2a87-4052-a1c0-e679fab2b6df
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Administrators and identity management scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (((NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe") and (CommandLine contains "user" and CommandLine contains "/domain")) and (not((CommandLine contains "/add" or CommandLine contains "/delete")))) or (CommandLine contains "Get-ADUser" or CommandLine contains "Get-DomainUser" or CommandLine contains "Get-NetUser" or CommandLine contains "dsquery user" or CommandLine contains "objectcategory=person")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
