// Title: Accessibility Program Overwritten with copy or move
// ATT&CK: T1546.008 | Tactic: PrivilegeEscalation, Persistence | Sigma id: 713e076f-9f85-4e05-82ad-894059f09b1a
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: High
// False positives: None expected
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") and (ProcessCommandLine contains "copy " or ProcessCommandLine contains "move " or ProcessCommandLine contains "Copy-Item" or ProcessCommandLine contains "Move-Item") and (ProcessCommandLine contains "\\sethc.exe" or ProcessCommandLine contains "\\utilman.exe" or ProcessCommandLine contains "\\osk.exe" or ProcessCommandLine contains "\\Magnify.exe" or ProcessCommandLine contains "\\Narrator.exe" or ProcessCommandLine contains "\\DisplaySwitch.exe" or ProcessCommandLine contains "\\AtBroker.exe")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
