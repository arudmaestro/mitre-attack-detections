// Title: Permanent WMI Event Subscription Created from the Command Line
// ATT&CK: T1546.003 | Tactic: PrivilegeEscalation, Persistence | Sigma id: 3c9eed57-ad3c-4116-8872-baf2c60d4d92
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Management agents that register WMI subscriptions (SCCM, some monitoring tools)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where CommandLine contains "__EventFilter" or CommandLine contains "CommandLineEventConsumer" or CommandLine contains "ActiveScriptEventConsumer" or CommandLine contains "__FilterToConsumerBinding"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
