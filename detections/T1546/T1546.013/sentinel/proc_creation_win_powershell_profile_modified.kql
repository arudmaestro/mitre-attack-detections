// Title: PowerShell Profile Written from the Command Line
// ATT&CK: T1546.013 | Tactic: PrivilegeEscalation, Persistence | Sigma id: e4660922-ef5b-4a43-8c58-c34810b1809e
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Users and setup scripts customising their PowerShell profile
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (ProcessCommandLine contains "$PROFILE" or ProcessCommandLine contains "Microsoft.PowerShell_profile.ps1" or ProcessCommandLine contains "\\WindowsPowerShell\\profile.ps1" or ProcessCommandLine contains "\\PowerShell\\profile.ps1") and (ProcessCommandLine contains "Add-Content" or ProcessCommandLine contains "Set-Content" or ProcessCommandLine contains "Out-File" or ProcessCommandLine contains "Copy-Item" or ProcessCommandLine contains ">>")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
