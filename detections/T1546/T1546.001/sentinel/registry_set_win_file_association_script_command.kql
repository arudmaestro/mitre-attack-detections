// Title: File Association Open Command Set to a Script Host
// ATT&CK: T1546.001 | Tactic: PrivilegeEscalation, Persistence | Sigma id: 3f32a1a5-2b8d-4d63-a426-e358a1bce6b8
// Data source: DeviceRegistryEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Applications that register PowerShell or script files with a custom handler
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = InitiatingProcessAccountName, RegistryKey = RegistryKey, RegistryValue = RegistryValueName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceRegistryEvents
| where TimeGenerated > ago(1d)
| where ActionType == "RegistryValueSet"
| extend TargetObject = strcat(RegistryKey, "\\", RegistryValueName)
| where TargetObject contains "\\shell\\open\\command\\" and (RegistryValueData contains "powershell" or RegistryValueData contains "pwsh" or RegistryValueData contains "mshta" or RegistryValueData contains "wscript" or RegistryValueData contains "cscript" or RegistryValueData contains "regsvr32" or RegistryValueData contains "cmd.exe /c" or RegistryValueData contains "cmd /c" or RegistryValueData contains "%COMSPEC%" or RegistryValueData contains "\\AppData\\Local\\Temp\\" or RegistryValueData contains "\\Users\\Public\\")
| project TimeGenerated, DeviceName, ActionType, InitiatingProcessAccountName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, RegistryKey, RegistryValueName, RegistryValueType, RegistryValueData
