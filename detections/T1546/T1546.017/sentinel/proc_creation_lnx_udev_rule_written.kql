// Title: Udev Rule Written from the Command Line
// ATT&CK: T1546.017 | Tactic: Persistence, PrivilegeEscalation | Sigma id: a7212feb-e336-4065-bd67-4806a16ebd23
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Administrators and hardware vendor installers adding device rules
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "/cp" or FolderPath endswith "/mv" or FolderPath endswith "/tee" or FolderPath endswith "/ln" or FolderPath endswith "/install" or FolderPath endswith "/sed") and (ProcessCommandLine contains "/etc/udev/rules.d/" or ProcessCommandLine contains "/lib/udev/rules.d/")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
