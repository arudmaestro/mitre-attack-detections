// Title: Windows Firewall Disabled from the Command Line
// ATT&CK: T1686.003 | Tactic: DefenseImpairment | Sigma id: b7c8be69-d815-4821-9b12-9bf9b187d8b6
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: High
// False positives: Administrators troubleshooting connectivity
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\netsh.exe" and (ProcessCommandLine contains "state off" or ProcessCommandLine contains "opmode disable" or ProcessCommandLine contains "opmode mode=disable")) or (ProcessCommandLine contains "Set-NetFirewallProfile" and (ProcessCommandLine contains "-Enabled False" or ProcessCommandLine contains "-Enabled 0"))
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
