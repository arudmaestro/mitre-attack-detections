// Title: Windows Firewall Disabled from the Command Line
// ATT&CK: T1686.003 | Tactic: DefenseImpairment | Sigma id: b7c8be69-d815-4821-9b12-9bf9b187d8b6
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Administrators troubleshooting connectivity
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\netsh.exe" and (CommandLine contains "state off" or CommandLine contains "opmode disable" or CommandLine contains "opmode mode=disable")) or (CommandLine contains "Set-NetFirewallProfile" and (CommandLine contains "-Enabled False" or CommandLine contains "-Enabled 0"))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
