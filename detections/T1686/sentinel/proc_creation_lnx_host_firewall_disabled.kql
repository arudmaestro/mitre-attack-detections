// Title: Host Firewall Disabled or Flushed on Linux
// ATT&CK: T1686 | Tactic: DefenseImpairment | Sigma id: 62f3f6e4-332a-4173-ab91-70cb6427f1e5
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Administrators and configuration management reloading firewall rules (a flush followed by new rules)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "/ufw" and ProcessCommandLine contains "disable") or ((FolderPath endswith "/iptables" or FolderPath endswith "/ip6tables") and (ProcessCommandLine contains " -F" or ProcessCommandLine contains "--flush")) or (FolderPath endswith "/nft" and ProcessCommandLine contains "flush ruleset") or ((FolderPath endswith "/systemctl" or FolderPath endswith "/service") and (ProcessCommandLine contains "firewalld" or ProcessCommandLine contains "ufw" or ProcessCommandLine contains "iptables") and (ProcessCommandLine contains " stop" or ProcessCommandLine contains " disable" or ProcessCommandLine contains " mask"))
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
