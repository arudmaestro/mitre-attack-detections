// Title: Privileged or Host-Mounting Container Started
// ATT&CK: T1610 | Tactic: Execution | Sigma id: cf713274-3c33-4ed0-949b-dc787c625c8c
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: High
// False positives: Monitoring agents and system containers deployed with host access (they usually start from orchestration, not the CLI)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "/docker" or FolderPath endswith "/podman" or FolderPath endswith "/nerdctl") and ProcessCommandLine contains " run " and (ProcessCommandLine contains "--privileged" or ProcessCommandLine contains " -v /:/" or ProcessCommandLine contains "--volume /:/" or ProcessCommandLine contains "--volume=/:/" or ProcessCommandLine contains "--pid=host" or ProcessCommandLine contains "--pid host")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
