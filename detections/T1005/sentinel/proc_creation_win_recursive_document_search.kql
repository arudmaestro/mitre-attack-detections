// Title: Recursive Search for Documents and Data Files
// ATT&CK: T1005 | Tactic: Collection | Sigma id: 535b5844-c3af-45c6-9eb4-5f297969c1af
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Users and administrators searching for files; Backup and inventory scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where ((ProcessCommandLine contains "dir " and ProcessCommandLine contains " /s") or (ProcessCommandLine contains "Get-ChildItem" and ProcessCommandLine contains "-Recurse")) and (ProcessCommandLine contains ".doc" or ProcessCommandLine contains ".xls" or ProcessCommandLine contains ".pdf" or ProcessCommandLine contains ".kdbx" or ProcessCommandLine contains ".pst" or ProcessCommandLine contains ".sqlite")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
