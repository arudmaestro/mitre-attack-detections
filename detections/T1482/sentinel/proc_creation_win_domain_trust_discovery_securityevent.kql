// Title: Domain Trust Discovery
// ATT&CK: T1482 | Tactic: Discovery | Sigma id: 0452775f-affc-47b6-9543-0dedd6b22443
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Administrators and AD health or audit scripts reviewing trusts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where CommandLine contains "/domain_trusts" or CommandLine contains "/all_trusts" or CommandLine contains "/trusted_domains" or CommandLine contains "trustedDomain" or CommandLine contains "Get-ADTrust" or CommandLine contains "Get-DomainTrust" or CommandLine contains "Get-NetDomainTrust" or CommandLine contains "Get-ForestTrust" or CommandLine contains "GetAllTrustRelationships"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
