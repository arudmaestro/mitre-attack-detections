// Title: Sleep or Hibernation Settings Changed with powercfg
// ATT&CK: T1653 | Tactic: Persistence | Sigma id: 92a9f185-0872-401f-a90c-12fe10059395
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Power-management GPOs and scripts on kiosks, servers and lab machines
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where NewProcessName endswith "\\powercfg.exe" and (CommandLine contains "/change" or CommandLine contains "-change" or CommandLine contains "/x " or CommandLine contains "-x " or CommandLine contains "/hibernate off" or CommandLine contains "-h off")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
