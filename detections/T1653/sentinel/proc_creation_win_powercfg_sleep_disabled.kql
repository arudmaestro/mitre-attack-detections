// Title: Sleep or Hibernation Settings Changed with powercfg
// ATT&CK: T1653 | Tactic: Persistence | Sigma id: 92a9f185-0872-401f-a90c-12fe10059395
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Power-management GPOs and scripts on kiosks, servers and lab machines
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where FolderPath endswith "\\powercfg.exe" and (ProcessCommandLine contains "/change" or ProcessCommandLine contains "-change" or ProcessCommandLine contains "/x " or ProcessCommandLine contains "-x " or ProcessCommandLine contains "/hibernate off" or ProcessCommandLine contains "-h off")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
