// Title: System Service Discovery via sc, tasklist or net
// ATT&CK: T1007 | Tactic: Discovery | Sigma id: 539c94de-400b-4217-b5be-f9bd10f1606e
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Low
// False positives: Administrators and IT management tools; Software installers checking service state
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\sc.exe" and (ProcessCommandLine contains " query" or ProcessCommandLine contains " qc ")) or (FolderPath endswith "\\tasklist.exe" and ProcessCommandLine contains "/svc") or ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") and ProcessCommandLine endswith " start")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
