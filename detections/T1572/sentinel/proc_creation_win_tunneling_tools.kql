// Title: Tunneling Tool Executed on Windows
// ATT&CK: T1572 | Tactic: CommandAndControl | Sigma id: 20be19cd-6e99-49e0-b30c-2194fe850b91
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: High
// False positives: Developers using ngrok or Cloudflare Tunnel for testing; IT using sanctioned tunnels
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "\\ngrok.exe" or FolderPath endswith "\\chisel.exe" or FolderPath endswith "\\frpc.exe") or (FolderPath endswith "\\cloudflared.exe" and ProcessCommandLine contains "tunnel") or (FolderPath endswith "\\plink.exe" and (ProcessCommandLine contains " -R " or ProcessCommandLine contains " -D "))
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
