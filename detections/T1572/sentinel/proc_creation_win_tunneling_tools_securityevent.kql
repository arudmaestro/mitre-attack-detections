// Title: Tunneling Tool Executed on Windows
// ATT&CK: T1572 | Tactic: CommandAndControl | Sigma id: 20be19cd-6e99-49e0-b30c-2194fe850b91
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Developers using ngrok or Cloudflare Tunnel for testing; IT using sanctioned tunnels
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\ngrok.exe" or NewProcessName endswith "\\chisel.exe" or NewProcessName endswith "\\frpc.exe") or (NewProcessName endswith "\\cloudflared.exe" and CommandLine contains "tunnel") or (NewProcessName endswith "\\plink.exe" and (CommandLine contains " -R " or CommandLine contains " -D "))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
