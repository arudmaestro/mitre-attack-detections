// Title: File Copied to a Remote Admin Share
// ATT&CK: T1570 | Tactic: LateralMovement | Sigma id: 8566a182-f84c-4e4e-9e3f-0c02aa5edadf
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Software deployment and administrators copying files to servers through admin shares
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (ProcessCommandLine contains "copy " or ProcessCommandLine contains "xcopy" or ProcessCommandLine contains "robocopy" or ProcessCommandLine contains "move " or ProcessCommandLine contains "Copy-Item") and (ProcessCommandLine contains "\\C$\\" or ProcessCommandLine contains "\\ADMIN$\\")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
