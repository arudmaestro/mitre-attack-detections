// Title: File Copied to a Remote Admin Share
// ATT&CK: T1570 | Tactic: LateralMovement | Sigma id: 8566a182-f84c-4e4e-9e3f-0c02aa5edadf
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Software deployment and administrators copying files to servers through admin shares
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (CommandLine contains "copy " or CommandLine contains "xcopy" or CommandLine contains "robocopy" or CommandLine contains "move " or CommandLine contains "Copy-Item") and (CommandLine contains "\\C$\\" or CommandLine contains "\\ADMIN$\\")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
