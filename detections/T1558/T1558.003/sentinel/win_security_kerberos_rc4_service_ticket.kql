// Title: Kerberos Service Ticket Requested with RC4 Encryption (4769)
// ATT&CK: T1558.003 | Tactic: CredentialAccess | Sigma id: ffdbd384-9128-4362-89a2-4a1139356560
// Data source: SecurityEvent 4769 (Windows Security Events connector)
// Severity: Medium
// False positives: Legacy applications and services that still only support RC4
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4769
| extend TicketEncryptionType = extract(@'<Data Name="TicketEncryptionType">([^<]*)</Data>', 1, EventData)
| extend TicketOptions = extract(@'<Data Name="TicketOptions">([^<]*)</Data>', 1, EventData)
| where (TicketEncryptionType =~ "0x17" and EventID == 4769 and Status =~ "0x0") and (not(ServiceName endswith "$")) and (not(ServiceName =~ "krbtgt")) and (not(TargetUserName contains "$@"))
| project TimeGenerated, Computer, TargetUserName, TargetDomainName, ServiceName, IpAddress, Status, TicketOptions, TicketEncryptionType
