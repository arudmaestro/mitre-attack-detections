// Title: Service ImagePath Set to a Script Host or a File in a User Folder
// ATT&CK: T1543.003 | Tactic: Persistence, PrivilegeEscalation | Sigma id: d35b2da4-9ba1-468e-9dd9-1be81f31456e
// Data source: DeviceRegistryEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: High
// False positives: Software installers that wrap services in a script (rare)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = InitiatingProcessAccountName, RegistryKey = RegistryKey, RegistryValue = RegistryValueName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceRegistryEvents
| where TimeGenerated > ago(1d)
| where ActionType == "RegistryValueSet"
| extend TargetObject = strcat(RegistryKey, "\\", RegistryValueName)
| where TargetObject contains "\\Services\\" and TargetObject endswith "\\ImagePath" and (RegistryValueData contains "powershell" or RegistryValueData contains "pwsh" or RegistryValueData contains "mshta" or RegistryValueData contains "wscript" or RegistryValueData contains "cscript" or RegistryValueData contains "regsvr32" or RegistryValueData contains "cmd.exe /c" or RegistryValueData contains "cmd /c" or RegistryValueData contains "%COMSPEC%" or RegistryValueData contains "\\AppData\\Local\\Temp\\" or RegistryValueData contains "\\Users\\Public\\")
| project TimeGenerated, DeviceName, ActionType, InitiatingProcessAccountName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, RegistryKey, RegistryValueName, RegistryValueType, RegistryValueData
