// Title: Launch Daemon Created or Loaded from the Command Line
// ATT&CK: T1543.004 | Tactic: Persistence, PrivilegeEscalation | Sigma id: 624ca7ca-da33-4155-8ef5-cf01b89f7761
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Software installers registering daemons
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "/cp" or FolderPath endswith "/mv" or FolderPath endswith "/tee" or FolderPath endswith "/ln" or FolderPath endswith "/plutil" or FolderPath endswith "/defaults" or FolderPath endswith "/launchctl") and ProcessCommandLine contains "/Library/LaunchDaemons/"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
