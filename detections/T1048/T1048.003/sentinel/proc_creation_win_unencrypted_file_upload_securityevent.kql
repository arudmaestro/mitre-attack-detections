// Title: File Upload over FTP or TFTP from the Command Line
// ATT&CK: T1048.003 | Tactic: Exfiltration | Sigma id: 81d2d5f8-0e50-420f-af15-54e8ee87a6eb
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Legacy file-transfer scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\ftp.exe" and CommandLine contains "-s:") or (NewProcessName endswith "\\tftp.exe" and CommandLine contains " put ") or ((NewProcessName endswith "\\curl.exe" and CommandLine contains "ftp://") and (CommandLine contains " -T " or CommandLine contains "--upload-file"))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
