// Title: Remote System Discovery via net or nltest
// ATT&CK: T1018 | Tactic: Discovery | Sigma id: e788846d-91a4-4a1c-98a3-1580575d0af0
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Administrators and IT inventory scripts
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where ((NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe") and CommandLine contains " view") or ((NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe") and (CommandLine contains "group" and CommandLine contains "domain computers")) or (NewProcessName endswith "\\nltest.exe" and (CommandLine contains "/dclist" or CommandLine contains "/dsgetdc"))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
