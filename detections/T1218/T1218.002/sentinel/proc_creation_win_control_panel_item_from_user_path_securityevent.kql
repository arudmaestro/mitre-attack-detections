// Title: Control Panel Item Loaded from a User-Writable Folder
// ATT&CK: T1218.002 | Tactic: Stealth | Sigma id: b55a0044-d2d1-494c-9895-94cc617afa39
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Software installers that open their own Control Panel item from a temporary folder
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\control.exe" or CommandLine contains "Control_RunDLL") and CommandLine contains ".cpl" and (CommandLine contains "\\AppData\\Local\\Temp\\" or CommandLine contains "\\AppData\\Roaming\\" or CommandLine contains "\\Downloads\\" or CommandLine contains "\\Users\\Public\\")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
