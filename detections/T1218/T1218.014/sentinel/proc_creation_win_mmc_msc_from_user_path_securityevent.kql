// Title: MMC Opening a Console File from a User-Writable Folder
// ATT&CK: T1218.014 | Tactic: Stealth | Sigma id: eaedae5f-107d-404e-9a88-47e03da29db3
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Administrators opening saved custom consoles from their profile
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\mmc.exe" and CommandLine contains ".msc") and (CommandLine contains "\\AppData\\Local\\Temp\\" or CommandLine contains "\\AppData\\Roaming\\" or CommandLine contains "\\Downloads\\" or CommandLine contains "\\Users\\Public\\")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
