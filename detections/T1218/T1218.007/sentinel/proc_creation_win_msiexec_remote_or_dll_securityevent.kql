// Title: Msiexec Installing from a URL or Registering a DLL
// ATT&CK: T1218.007 | Tactic: Stealth | Sigma id: bbd745e6-1a7c-47b7-931b-f42dbfb0046a
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: Software deployment that installs MSI packages from an internal web server
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where NewProcessName endswith "\\msiexec.exe" and ((CommandLine contains "http://" or CommandLine contains "https://") or (CommandLine contains " /y" or CommandLine contains " -y" or CommandLine contains " /z" or CommandLine contains " -z"))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
