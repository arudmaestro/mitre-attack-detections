// Title: Network Configuration Discovery Commands
// ATT&CK: T1016 | Tactic: Discovery | Sigma id: 00f5040b-c751-46ff-95f6-1c8d6cc4479b
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Low
// False positives: Users, help desk and administrators troubleshooting networks
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\ipconfig.exe" and CommandLine contains "/all") or (NewProcessName endswith "\\route.exe" and CommandLine contains "print") or (NewProcessName endswith "\\arp.exe" and CommandLine contains "-a") or (NewProcessName endswith "\\netsh.exe" and (CommandLine contains "interface" and CommandLine contains "show"))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
