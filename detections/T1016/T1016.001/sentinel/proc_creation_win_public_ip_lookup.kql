// Title: Public IP or Internet Connectivity Lookup Service in Command Line
// ATT&CK: T1016.001 | Tactic: Discovery | Sigma id: 4315208a-2f8d-4e73-a475-15498af51a4e
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: IT scripts and VPN or monitoring tools that check the public IP
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where ProcessCommandLine contains "api.ipify.org" or ProcessCommandLine contains "ifconfig.me" or ProcessCommandLine contains "icanhazip.com" or ProcessCommandLine contains "ipinfo.io" or ProcessCommandLine contains "checkip.amazonaws.com" or ProcessCommandLine contains "myip.opendns.com" or ProcessCommandLine contains "ip-api.com" or ProcessCommandLine contains "wtfismyip.com" or ProcessCommandLine contains "checkip.dyndns.org"
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
