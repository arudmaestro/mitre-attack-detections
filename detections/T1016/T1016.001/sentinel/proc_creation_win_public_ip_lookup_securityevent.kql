// Title: Public IP or Internet Connectivity Lookup Service in Command Line
// ATT&CK: T1016.001 | Tactic: Discovery | Sigma id: 4315208a-2f8d-4e73-a475-15498af51a4e
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: Medium
// False positives: IT scripts and VPN or monitoring tools that check the public IP
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where CommandLine contains "api.ipify.org" or CommandLine contains "ifconfig.me" or CommandLine contains "icanhazip.com" or CommandLine contains "ipinfo.io" or CommandLine contains "checkip.amazonaws.com" or CommandLine contains "myip.opendns.com" or CommandLine contains "ip-api.com" or CommandLine contains "wtfismyip.com" or CommandLine contains "checkip.dyndns.org"
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
