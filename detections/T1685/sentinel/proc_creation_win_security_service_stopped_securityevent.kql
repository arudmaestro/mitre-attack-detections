// Title: Security Product Service Stopped, Disabled or Deleted
// ATT&CK: T1685 | Tactic: DefenseImpairment | Sigma id: baff6b95-d346-4dfb-ae70-fe941b05b481
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Product upgrades and uninstallers run by IT
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where ((NewProcessName endswith "\\sc.exe" or NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe" or NewProcessName endswith "\\taskkill.exe") and (CommandLine contains " stop " or CommandLine contains " delete " or CommandLine contains " config " or CommandLine contains "/im ") and (CommandLine contains "WinDefend" or CommandLine contains "WdNisSvc" or CommandLine contains "MsMpEng" or CommandLine contains " Sense" or CommandLine contains "SepMasterService" or CommandLine contains "CSFalconService" or CommandLine contains "SentinelAgent" or CommandLine contains "cbdefense" or CommandLine contains "Sysmon")) or (NewProcessName endswith "\\fltMC.exe" and CommandLine contains "unload")
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
