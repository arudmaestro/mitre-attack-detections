// Title: Event Log Channel or Audit Policy Disabled from the Command Line
// ATT&CK: T1685.001 | Tactic: DefenseImpairment | Sigma id: 201af407-0223-4f6f-a4ce-b304dafbbc7c
// Data source: SecurityEvent 4688 (Windows Security Events connector; needs process creation and command-line auditing enabled)
// Severity: High
// False positives: Administrators tuning audit policy (should go through GPO)
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = Computer, Account = SubjectUserName
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
SecurityEvent
| where TimeGenerated > ago(1d)
| where EventID == 4688
| where (NewProcessName endswith "\\wevtutil.exe" and (CommandLine contains "/e:false" or CommandLine contains "/enabled:false")) or (NewProcessName endswith "\\auditpol.exe" and (CommandLine contains "/clear" or CommandLine contains "/remove" or CommandLine contains "disable")) or ((NewProcessName endswith "\\sc.exe" or NewProcessName endswith "\\net.exe" or NewProcessName endswith "\\net1.exe") and CommandLine contains "eventlog" and (CommandLine contains " stop" or CommandLine contains "disabled"))
| project TimeGenerated, Computer, SubjectUserName, ParentProcessName, NewProcessName, CommandLine
