// Title: PAM Configuration or Module Written from the Command Line
// ATT&CK: T1556.003 | Tactic: DefenseImpairment, Persistence, CredentialAccess | Sigma id: 6105b01b-ff91-41a3-b4ac-a9eb738629ef
// Data source: DeviceProcessEvents (Microsoft Defender for Endpoint / Defender XDR connector)
// Severity: Medium
// False positives: Configuration management, authconfig/authselect and package scripts changing PAM
// Suggested analytics rule: run every 15m, look back 30m, alert when results > 0.
// Entity mapping: Host = DeviceName, Account = AccountName, Process = ProcessCommandLine
// The time filter below is for ad-hoc hunting; the analytics rule's lookback applies when scheduled.
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where (FolderPath endswith "/cp" or FolderPath endswith "/mv" or FolderPath endswith "/tee" or FolderPath endswith "/ln" or FolderPath endswith "/install" or FolderPath endswith "/sed") and (ProcessCommandLine contains "/etc/pam.d/" or ProcessCommandLine contains "/security/pam_")
| project TimeGenerated, DeviceName, AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, FileName, FolderPath, ProcessCommandLine
